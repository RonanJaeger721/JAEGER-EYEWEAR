# Local mode uses persistent .data/store.sqlite when DATABASE_URL is empty.
# Vercel fails closed for writes without persistent PostgreSQL.
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Blob for hosted photo uploads. Local uploads go to public/uploads.
BLOB_READ_WRITE_TOKEN=
# Only consumed by the operator bootstrap command, never public client code.
ADMIN_EMAIL=
ADMIN_NAME=Ronan
ADMIN_PASSWORD=
# Never set this on Vercel. Local automated test fixture only.
LOCAL_TEST_ORDERS=
